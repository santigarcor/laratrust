{
  "name": "laratrust",
  "version": "5.1.0",
  "description": "Laratrust docs and admin panel assets",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "0.5.11",
    "alpinejs": "3.17.4",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "vuepress": "^0.14.4"
  },
  "scripts": {
    "docs:dev": "NODE_OPTIONS=--openssl-legacy-provider vuepress dev docs",
    "docs:build": "NODE_OPTIONS=--openssl-legacy-provider vuepress build docs",
    "panel:css": "tailwindcss --input resources/css/laratrust.css --output dist/laratrust.css --minify",
    "panel:js": "esbuild resources/js/laratrust.js --bundle --minify --format=iife --target=es2020 --outfile=dist/laratrust.js",
    "panel:build": "npm run panel:css && npm run panel:js",
    "panel:watch": "npm run panel:css -- --watch & npm run panel:js -- --watch"
  },
  "author": "Santiago Garcia C",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/santigarcor/laratrust/issues"
  },
  "homepage": "https://github.com/santigarcor/laratrust#readme"
}
